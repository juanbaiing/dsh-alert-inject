{
  "name": "dsh-alert-inject",
  "version": "0.6.0",
  "description": "Give your coding agent a voice that speaks up when it's drifting: goal/constraint anchors, déjà-vu retrieval over its own context, repetition detection, reference checks, and context-block-scoped alert judges — all before it answers. Zero third-party deps; core works without any LLM.",
  "files": [
    "lib",
    "tools",
    "tests",
    "README.md",
    "CHANGELOG.md",
    "PROVIDERS.md",
    "ARTICLE.md",
    "PLUGIN.md",
    "REPORT.md",
    "DESIGN-evidence.md",
    "AGENTS.md",
    "cordis.patch.yml",
    "selftest.mjs",
    "leak-check.mjs"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node selftest.mjs",
    "leak-check": "node leak-check.mjs",
    "check-client": "node tools/check-client.mjs",
    "check-client-refs": "node tools/check-client-refs.mjs",
    "check-routes": "node tools/check-routes.mjs",
    "check-incremental": "node tools/check-incremental.mjs",
    "health": "node tools/health.mjs",
    "check-cross-context": "node tools/check-cross-context.mjs",
    "check-cross-e2e": "node tools/check-cross-e2e.mjs",
    "check-archive-dir": "node tools/check-archive-dir.mjs",
    "check-setting-docs": "node tools/check-setting-docs.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "metacognition",
    "self-monitoring",
    "context-engineering",
    "agent-awareness",
    "alert",
    "goal-drift",
    "retrieval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanbaiing/dsh-alert-inject.git"
  },
  "homepage": "https://github.com/juanbaiing/dsh-alert-inject#readme",
  "bugs": {
    "url": "https://github.com/juanbaiing/dsh-alert-inject/issues"
  },
  "author": "juanbaiing",
  "license": "MIT"
}
